# 1. Yandex Managed Service for YDB (Document API)
VITE_DATA_PROVIDER=yandex
VITE_YANDEX_YDB_DOCAPI_ENDPOINT=
VITE_YANDEX_REGION=ru-central1

# 2. Yandex Cloud Service Account Key (S3 & DynamoDB Compatible)
VITE_YANDEX_ACCESS_KEY_ID=
VITE_YANDEX_SECRET_ACCESS_KEY=

# 3. Yandex Object Storage (Document & Photo Vault)
VITE_YANDEX_STORAGE_BUCKET=
VITE_YANDEX_STORAGE_ENDPOINT=

# 4. Yandex ID OAuth
VITE_YANDEX_OAUTH_CLIENT_ID=
VITE_YANDEX_OAUTH_CLIENT_SECRET=
VITE_YANDEX_OAUTH_REDIRECT_URI=

# 5. Yandex Maps & Geoservices Ecosystem
VITE_YANDEX_MAPS_API_KEY=
VITE_YANDEX_GEOCODER_API_KEY=
VITE_YANDEX_SUGGEST_API_KEY=
